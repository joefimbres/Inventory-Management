# Shared inventory for every phone. Leave these blank to use this browser only.
# In the Vercel project, open Storage → Marketplace → Upstash Redis (free plan).
# Connect it to the project named inventory-management and redeploy.
# The integration adds one of these pairs. Either pair turns on shared storage.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Older Marketplace installs use these names instead. You do not need both pairs.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional. If set, the page asks for this PIN before it loads or saves.
# Share it with staff outside the repo. Do not commit the real value.
# INVENTORY_PIN=
