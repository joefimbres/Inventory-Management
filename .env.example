# Preferred shared store: a private Vercel Blob store connected to this project.
# Vercel sets this when the store is connected. Do not commit the real token.
# BLOB_READ_WRITE_TOKEN=

# Alternative shared store: Upstash Redis. Used only when Blob is not configured.
# In the Vercel project, open Storage → Marketplace → Upstash Redis (free plan).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Older Marketplace installs use these names instead. You do not need both pairs.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional. If set, the page asks for this PIN before it loads or saves.
# Share it with staff outside the repo. Do not commit the real value.
# INVENTORY_PIN=
